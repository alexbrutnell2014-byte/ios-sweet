diff --git a/bsd/dev/sweet_files.c b/bsd/dev/sweet_files.c
new file mode 100644
index 0000000..f0a4a91
--- /dev/null
+++ b/bsd/dev/sweet_files.c
@@ -0,0 +1,380 @@
+/*
+ * File server for the running iOS root, over USB Ethernet: TCP
+ * 192.168.7.2:2223 (on the Mac: 127.0.0.1:2223 through FlameBridge,
+ * tools/flame-files.py). One request per connection, a header line then
+ * data:
+ *
+ *   PUT <path> <mode-octal> <size>\n<size bytes>  -> "OK <size>\n"  (root:wheel)
+ *   GET <path>\n                                  -> "OK <size>\n<bytes>"
+ *   READ <path> <offset> <len>\n                  -> "OK <len>\n<bytes>"  (decimal; for
+ *                                                    devices, e.g. /dev/pmem at a PA)
+ *   MKDIR <path> <mode-octal>\n                   -> "OK\n"
+ *   LINK <target> <path>\n                        -> "OK\n"  (symlink)
+ *   RM <path>\n                                   -> "OK\n"
+ *   CHMOD <path> <mode-octal>\n                   -> "OK\n"
+ *
+ * Errors: "ERR <errno>\n". Paths have no spaces. Started with the USB
+ * gadget (sweet_usb.c) when the interface comes up.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/kernel.h>
+#include <sys/kauth.h>
+#include <sys/kpi_socket.h>
+#include <sys/socket.h>
+#include <sys/uio.h>
+#include <netinet/in.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <libkern/libkern.h>
+
+extern int sweet_vfs_mkdir(const char *path, int mode);
+extern int sweet_vfs_symlink(const char *target, const char *link);
+extern int sweet_vfs_unlink(const char *path);
+extern kern_return_t thread_terminate(thread_t);
+void sweet_files_start(void);
+
+#define SF_BUF  (64 * 1024)
+
+static char *sf_buf;
+static int sf_chan;
+
+static void
+sf_sleep_ms(int ms)
+{
+	(void)tsleep(&sf_chan, PZERO, "sweetfiles", MAX(1, ms * hz / 1000));
+}
+
+static unsigned long long
+sf_dec(const char *p)
+{
+	unsigned long long v = 0;
+	while (*p == ' ') {
+		p++;
+	}
+	while (*p >= '0' && *p <= '9') {
+		v = v * 10 + (unsigned)(*p++ - '0');
+	}
+	return v;
+}
+
+static int
+sf_recv(socket_t so, void *buf, size_t len, size_t *got, int flags)
+{
+	struct iovec iov = { .iov_base = buf, .iov_len = len };
+	struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+	return sock_receive(so, &msg, flags, got);
+}
+
+static int
+sf_recv_all(socket_t so, void *buf, size_t len)
+{
+	size_t off = 0;
+	while (off < len) {
+		size_t got = 0;
+		int err = sf_recv(so, (char *)buf + off, len - off, &got, MSG_WAITALL);
+		if (err) {
+			return err;
+		}
+		if (got == 0) {
+			return ECONNRESET;
+		}
+		off += got;
+	}
+	return 0;
+}
+
+static int
+sf_send(socket_t so, const void *buf, size_t len)
+{
+	size_t off = 0;
+	while (off < len) {
+		struct iovec iov = { .iov_base = (char *)buf + off, .iov_len = len - off };
+		struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+		size_t sent = 0;
+		int err = sock_send(so, &msg, 0, &sent);
+		if (err) {
+			return err;
+		}
+		off += sent;
+	}
+	return 0;
+}
+
+static void
+sf_reply(socket_t so, int err, uint64_t n, bool with_n)
+{
+	char line[48];
+	int len = err ? snprintf(line, sizeof(line), "ERR %d\n", err) :
+	    with_n ? snprintf(line, sizeof(line), "OK %llu\n", n) : snprintf(line, sizeof(line), "OK\n");
+	(void)sf_send(so, line, (size_t)len);
+}
+
+/* Header line: up to '\n', read byte by byte so data after it stays queued. */
+static int
+sf_line(socket_t so, char *line, size_t max)
+{
+	size_t n = 0;
+	while (n + 1 < max) {
+		size_t got = 0;
+		int err = sf_recv(so, line + n, 1, &got, MSG_WAITALL);
+		if (err || got == 0) {
+			return err ? err : ECONNRESET;
+		}
+		if (line[n] == '\n') {
+			break;
+		}
+		n++;
+	}
+	line[n] = 0;
+	return 0;
+}
+
+static int
+sf_setattr(const char *path, int mode, bool owner)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_lookup(path, 0, &vp, ctx);
+	if (err) {
+		return err;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, mode & 07777);
+	if (owner) {
+		VATTR_SET(&va, va_uid, 0);
+		VATTR_SET(&va, va_gid, 0);
+	}
+	err = vnode_setattr(vp, &va, ctx);
+	vnode_put(vp);
+	return err;
+}
+
+static int
+sf_put(socket_t so, const char *path, int mode, uint64_t size)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_open(path, O_CREAT | O_TRUNC | FWRITE, mode & 07777, 0, &vp, ctx);
+	uint64_t off = 0;
+	while (off < size) {
+		size_t chunk = (size_t)MIN((uint64_t)SF_BUF, size - off);
+		int rerr = sf_recv_all(so, sf_buf, chunk);
+		if (rerr) {
+			err = err ? err : rerr;
+			break;
+		}
+		if (!err) {
+			int resid = 0;
+			err = vn_rdwr(UIO_WRITE, vp, sf_buf, (int)chunk, (off_t)off, UIO_SYSSPACE, IO_UNIT,
+			    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+			if (!err && resid) {
+				err = EIO;
+			}
+		}
+		off += chunk;
+	}
+	if (vp != NULLVP) {
+		vnode_close(vp, FWRITE, ctx);
+	}
+	if (!err) {
+		err = sf_setattr(path, mode, true);
+	}
+	return err;
+}
+
+static int
+sf_get(socket_t so, const char *path)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	off_t size = 0;
+	int err = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (!err) {
+		err = vnode_size(vp, &size, ctx);
+	}
+	if (err) {
+		if (vp != NULLVP) {
+			vnode_close(vp, FREAD, ctx);
+		}
+		sf_reply(so, err, 0, false);
+		return err;
+	}
+	sf_reply(so, 0, (uint64_t)size, true);
+	for (off_t off = 0; off < size && !err;) {
+		int chunk = (int)MIN((off_t)SF_BUF, size - off), resid = 0;
+		err = vn_rdwr(UIO_READ, vp, sf_buf, chunk, off, UIO_SYSSPACE, IO_UNIT,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (!err) {
+			err = sf_send(so, sf_buf, (size_t)(chunk - resid));
+		}
+		off += chunk;
+	}
+	vnode_close(vp, FREAD, ctx);
+	return err;
+}
+
+/* Range read: works on character devices (vnode_size is 0 there). */
+static int
+sf_read(socket_t so, const char *path, uint64_t off, uint64_t len)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (err) {
+		sf_reply(so, err, 0, false);
+		return err;
+	}
+	/* Read the first chunk before replying, so a bad offset gives ERR. */
+	int chunk = (int)MIN((uint64_t)SF_BUF, len), resid = 0;
+	err = vn_rdwr(UIO_READ, vp, sf_buf, chunk, (off_t)off, UIO_SYSSPACE, IO_UNIT,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	if (err || resid) {
+		vnode_close(vp, FREAD, ctx);
+		sf_reply(so, err ? err : EIO, 0, false);
+		return err ? err : EIO;
+	}
+	sf_reply(so, 0, len, true);
+	for (uint64_t done = 0;;) {
+		err = sf_send(so, sf_buf, (size_t)chunk);
+		done += (uint64_t)chunk;
+		if (err || done >= len) {
+			break;
+		}
+		chunk = (int)MIN((uint64_t)SF_BUF, len - done);
+		err = vn_rdwr(UIO_READ, vp, sf_buf, chunk, (off_t)(off + done), UIO_SYSSPACE, IO_UNIT,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (err || resid) {
+			err = err ? err : EIO;
+			break;          /* short stream: the client sees a closed socket */
+		}
+	}
+	vnode_close(vp, FREAD, ctx);
+	return err;
+}
+
+static void
+sf_handle(socket_t so)
+{
+	static char line[1100];
+	char a[512], b[512];
+	unsigned long long n = 0;
+	int err = sf_line(so, line, sizeof(line));
+	if (err) {
+		return;
+	}
+	a[0] = b[0] = 0;
+	if (!strncmp(line, "PUT ", 4)) {
+		unsigned mode = 0644;
+		char *p = line + 4, *sp = strchr(p, ' ');
+		if (!sp || (size_t)(sp - p) >= sizeof(a)) {
+			sf_reply(so, EINVAL, 0, false);
+			return;
+		}
+		memcpy(a, p, (size_t)(sp - p));
+		a[sp - p] = 0;
+		mode = (unsigned)strtoul(sp + 1, &p, 8);
+		n = sf_dec(p);
+		err = sf_put(so, a, (int)mode, n);
+		printf("SWEET FILES: PUT %s %o %llu -> %d\n", a, mode, n, err);
+		sf_reply(so, err, n, true);
+		return;
+	}
+	if (!strncmp(line, "GET ", 4)) {
+		err = sf_get(so, line + 4);
+		printf("SWEET FILES: GET %s -> %d\n", line + 4, err);
+		return;
+	}
+	if (!strncmp(line, "READ ", 5)) {
+		char *p = line + 5, *sp = strchr(p, ' ');
+		if (!sp || (size_t)(sp - p) >= sizeof(a)) {
+			sf_reply(so, EINVAL, 0, false);
+			return;
+		}
+		memcpy(a, p, (size_t)(sp - p));
+		a[sp - p] = 0;
+		unsigned long long off = strtoul(sp + 1, &p, 10);   /* 64-bit long */
+		n = sf_dec(p);
+		err = sf_read(so, a, off, n);
+		printf("SWEET FILES: READ %s %llu %llu -> %d\n", a, off, n, err);
+		return;
+	}
+	char *sp = strchr(line, ' ');
+	if (!sp) {
+		sf_reply(so, EINVAL, 0, false);
+		return;
+	}
+	*sp = 0;
+	char *arg1 = sp + 1, *arg2 = strchr(arg1, ' ');
+	if (arg2) {
+		*arg2++ = 0;
+	}
+	if (!strcmp(line, "MKDIR")) {
+		err = sweet_vfs_mkdir(arg1, arg2 ? (int)strtoul(arg2, NULL, 8) : 0755);
+		if (err == EEXIST) {
+			err = 0;
+		}
+	} else if (!strcmp(line, "LINK") && arg2) {
+		err = sweet_vfs_symlink(arg1, arg2);
+	} else if (!strcmp(line, "RM")) {
+		err = sweet_vfs_unlink(arg1);
+	} else if (!strcmp(line, "CHMOD") && arg2) {
+		err = sf_setattr(arg1, (int)strtoul(arg2, NULL, 8), false);
+	} else {
+		err = EINVAL;
+	}
+	printf("SWEET FILES: %s %s %s -> %d\n", line, arg1, arg2 ? arg2 : "", err);
+	sf_reply(so, err, 0, false);
+}
+
+static void
+sf_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	socket_t ls = NULL;
+	struct sockaddr_in me;
+	int one = 1;
+
+	sf_buf = kalloc_data(SF_BUF, Z_WAITOK);
+	for (;;) {
+		if (sock_socket(PF_INET, SOCK_STREAM, IPPROTO_TCP, NULL, NULL, &ls) == 0) {
+			(void)sock_setsockopt(ls, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+			bzero(&me, sizeof(me));
+			me.sin_len = sizeof(me);
+			me.sin_family = AF_INET;
+			me.sin_port = htons(2223);
+			me.sin_addr.s_addr = htonl(INADDR_ANY);
+			if (sock_bind(ls, (struct sockaddr *)&me) == 0 && sock_listen(ls, 4) == 0) {
+				break;
+			}
+			sock_close(ls);
+		}
+		ls = NULL;
+		sf_sleep_ms(1000);
+	}
+	printf("SWEET FILES: listening on tcp 2223\n");
+	for (;;) {
+		socket_t c = NULL;
+		if (sock_accept(ls, NULL, 0, 0, NULL, NULL, &c) != 0 || c == NULL) {
+			sf_sleep_ms(100);
+			continue;
+		}
+		sf_handle(c);
+		sock_close(c);
+	}
+}
+
+void
+sweet_files_start(void)
+{
+	thread_t thread;
+	if (kernel_thread_start(sf_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_pmem.c b/bsd/dev/sweet_pmem.c
new file mode 100644
index 0000000..deee04d
--- /dev/null
+++ b/bsd/dev/sweet_pmem.c
@@ -0,0 +1,366 @@
+/*
+ * /dev/pmem: physical memory for userland hardware experiments (the GPU
+ * bring-up in work/userland/gpu runs on it over SSH, no reboot per try).
+ * Root only (0600); boot-arg sweetpmem=0 leaves the node out.
+ *
+ *   pread/pwrite at offset = physical address.
+ *     Managed DRAM goes through the physical aperture with the lines
+ *     cleaned+invalidated to the point of coherency before and after, so
+ *     data a device wrote is seen and CPU writes reach memory (IO is not
+ *     coherent here). Anything else (MMIO, carve-outs such as the panel
+ *     framebuffer) is mapped as device memory and accessed with 32-bit
+ *     loads/stores only: offset and length must be multiples of 4.
+ *     Reading an unclocked block hangs the SoC, as with poke scripts.
+ *   ioctl PMEM_ALLOC   {size, align} -> {pa}: zeroed, physically contiguous
+ *                      kernel memory (stays until PMEM_FREE, survives exit)
+ *   ioctl PMEM_FREE    {pa}
+ *   ioctl PMEM_SMC     x0..x7 in, x0..x3 out (SMCCC; e.g. SCM PAS calls)
+ *   ioctl PMEM_LIST    allocation table, for tools that lost their state
+ *   ioctl PMEM_RPMH    one RPMh active vote: resource name, 1-4 (offset, value) commands
+ *                      (ARC levels, VRM rails; bsd/dev/sweet_rpmh.c)
+ *
+ * Userland side: work/userland/gpu/pmem.h (same structs and numbers).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/ioccom.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern boolean_t pmap_valid_address(uint64_t pa);
+extern vm_map_address_t phystokv(uint64_t pa);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t sz);
+extern void _disable_preemption(void);
+extern void _enable_preemption(void);
+void sweet_pmem_init(void);
+
+struct pmem_alloc {
+	uint64_t size;          /* in: bytes (rounded up to pages) */
+	uint64_t align;         /* in: bytes, power of 2, 0 = page */
+	uint64_t pa;            /* out */
+};
+struct pmem_smc {
+	uint64_t x[8];
+};
+#define PMEM_LIST_MAX   64
+struct pmem_list {
+	uint32_t count;
+	uint32_t pad;
+	struct {
+		uint64_t pa, size;
+	} ent[PMEM_LIST_MAX];
+};
+#define PMEM_ALLOC      _IOWR('P', 1, struct pmem_alloc)
+#define PMEM_FREE       _IOW('P', 2, uint64_t)
+#define PMEM_SMC        _IOWR('P', 3, struct pmem_smc)
+#define PMEM_LIST       _IOR('P', 4, struct pmem_list)
+struct pmem_rpmh {
+	char res[16];           /* cmd-db name, e.g. "mss.lvl", "ldoa1" */
+	uint32_t n;             /* 1..4 commands */
+	uint32_t offset[4];     /* from the resource address */
+	uint32_t value[4];
+};
+#define PMEM_RPMH       _IOW('P', 5, struct pmem_rpmh)
+extern int sweet_rpmh_write(const char *res, unsigned n, const uint32_t *offsets, const uint32_t *values);
+
+#define PMEM_MAPS       16              /* 2 MB device windows, round robin */
+#define PMEM_WIN        0x200000ULL
+
+static struct {
+	vm_offset_t va;
+	uint64_t pa, size;
+} pm_alloc[PMEM_LIST_MAX];
+static struct {
+	vm_offset_t va;
+	uint64_t win;
+} pm_map[PMEM_MAPS];
+static unsigned pm_map_next;
+static uint32_t pm_bounce[PAGE_SIZE / 4];
+
+static LCK_GRP_DECLARE(sweet_pmem_grp, "sweet_pmem");
+static LCK_MTX_DECLARE(sweet_pmem_lock, &sweet_pmem_grp);
+
+/*
+ * Device mapping of the 2 MB window holding pa, from a small round-robin
+ * cache. ml_io_map's mappings are permanent (unmapping one panics) and come
+ * from the small io_submap (a 2 MB one panicked "kmem_alloc failed"), so
+ * windows use ml_io_map_unmappable: kernel_map, freed by ml_io_unmap.
+ */
+static volatile uint32_t *
+pm_io(uint64_t pa)
+{
+	uint64_t win = pa & ~(PMEM_WIN - 1);
+	for (unsigned i = 0; i < PMEM_MAPS; i++) {
+		if (pm_map[i].va && pm_map[i].win == win) {
+			return (volatile uint32_t *)(pm_map[i].va + (pa - win));
+		}
+	}
+	unsigned i = pm_map_next++ % PMEM_MAPS;
+	if (pm_map[i].va) {
+		ml_io_unmap(pm_map[i].va, PMEM_WIN);
+	}
+	pm_map[i].va = ml_io_map_unmappable((vm_offset_t)win, PMEM_WIN, VM_WIMG_IO);
+	pm_map[i].win = win;
+	return pm_map[i].va ? (volatile uint32_t *)(pm_map[i].va + (pa - win)) : NULL;
+}
+
+static int
+pm_rw(struct uio *uio, bool write)
+{
+	int err = 0;
+	lck_mtx_lock(&sweet_pmem_lock);
+	while (!err && uio_resid(uio) > 0) {
+		uint64_t pa = (uint64_t)uio_offset(uio);
+		uint64_t off = pa & PAGE_MASK;
+		unsigned n = (unsigned)MIN((user_ssize_t)(PAGE_SIZE - off), uio_resid(uio));
+		if (pmap_valid_address(pa)) {
+			caddr_t va = (caddr_t)phystokv(pa);
+			flush_dcache64((addr64_t)pa, n, TRUE);
+			err = uiomove(va, (int)n, uio);
+			flush_dcache64((addr64_t)pa, n, TRUE);
+			continue;
+		}
+		if ((pa | n) & 3) {
+			err = EINVAL;
+			break;
+		}
+		volatile uint32_t *r = pm_io(pa);
+		if (r == NULL) {
+			err = ENOMEM;
+			break;
+		}
+		if (write) {
+			err = uiomove((caddr_t)pm_bounce, (int)n, uio);
+			__asm__ volatile ("dmb oshst" ::: "memory");
+			for (unsigned i = 0; !err && i < n / 4; i++) {
+				r[i] = pm_bounce[i];
+			}
+			__asm__ volatile ("dsb osh" ::: "memory");
+		} else {
+			for (unsigned i = 0; i < n / 4; i++) {
+				pm_bounce[i] = r[i];
+			}
+			__asm__ volatile ("dmb oshld" ::: "memory");
+			err = uiomove((caddr_t)pm_bounce, (int)n, uio);
+		}
+	}
+	lck_mtx_unlock(&sweet_pmem_lock);
+	return err;
+}
+
+static int
+pm_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return pm_rw(uio, false);
+}
+
+static int
+pm_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return pm_rw(uio, true);
+}
+
+static int
+pm_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+pm_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+pm_smc_once(uint64_t x[8])
+{
+	register uint64_t x0 __asm__("x0") = x[0];
+	register uint64_t x1 __asm__("x1") = x[1];
+	register uint64_t x2 __asm__("x2") = x[2];
+	register uint64_t x3 __asm__("x3") = x[3];
+	register uint64_t x4 __asm__("x4") = x[4];
+	register uint64_t x5 __asm__("x5") = x[5];
+	register uint64_t x6 __asm__("x6") = x[6];
+	register uint64_t x7 __asm__("x7") = x[7];
+	__asm__ volatile ("smc #0"
+            : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+            :
+            : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	x[0] = x0;
+	x[1] = x1;
+	x[2] = x2;
+	x[3] = x3;
+	x[6] = x6;
+}
+
+/*
+ * Qualcomm TZ returns QCOM_SCM_INTERRUPTED (1) when a non-secure interrupt
+ * arrives during a call (the shim never saw it: interrupts off). Like
+ * Linux's __scm_smc_do_quirk: call again with x0 = 1, the same arguments
+ * and the x6 TZ handed back (ARM_SMCCC_QUIRK_QCOM_A6), on the same CPU,
+ * until a final result.
+ */
+#define QCOM_SCM_INTERRUPTED    1
+
+static void
+pm_smc(struct pmem_smc *s)
+{
+	uint64_t x[8], fn = s->x[0];
+	unsigned resumes = 0;
+	memcpy(x, s->x, sizeof(x));
+	_disable_preemption();
+	for (;;) {
+		pm_smc_once(x);
+		if (x[0] != QCOM_SCM_INTERRUPTED || resumes >= 100000) {
+			break;
+		}
+		uint64_t a6 = x[6];
+		memcpy(x, s->x, sizeof(x));
+		x[0] = QCOM_SCM_INTERRUPTED;
+		x[6] = a6;
+		resumes++;
+	}
+	_enable_preemption();
+	memcpy(s->x, x, 4 * sizeof(uint64_t));
+	if (resumes) {
+		printf("SWEET PMEM: smc %llx resumed %u times -> %llx\n", fn, resumes, x[0]);
+	}
+}
+
+static int
+pm_do_alloc(struct pmem_alloc *a)
+{
+	vm_size_t size = round_page(a->size);
+	uint64_t align = a->align > PAGE_SIZE ? a->align : PAGE_SIZE;
+	if (size == 0 || (align & (align - 1))) {
+		return EINVAL;
+	}
+	int slot = -1;
+	for (int i = 0; i < PMEM_LIST_MAX; i++) {
+		if (!pm_alloc[i].va) {
+			slot = i;
+			break;
+		}
+	}
+	if (slot < 0) {
+		return ENOSPC;
+	}
+	vm_offset_t va = 0;
+	if (kmem_alloc_contig(kernel_map, &va, size, PAGE_MASK, 0, (ppnum_t)(atop_64(align) - 1),
+	    KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)va);
+	if (!pn) {
+		kmem_free(kernel_map, va, size);
+		return ENOMEM;
+	}
+	a->pa = ptoa_64(pn);
+	flush_dcache64((addr64_t)a->pa, (unsigned)size, TRUE);
+	pm_alloc[slot].va = va;
+	pm_alloc[slot].pa = a->pa;
+	pm_alloc[slot].size = size;
+	printf("SWEET PMEM: alloc %llu bytes at 0x%llx (pid %d)\n", (uint64_t)size, a->pa, proc_selfpid());
+	return 0;
+}
+
+static int
+pm_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag, __unused struct proc *p)
+{
+	int err = 0;
+	lck_mtx_lock(&sweet_pmem_lock);
+	switch (cmd) {
+	case PMEM_ALLOC:
+		err = pm_do_alloc((struct pmem_alloc *)data);
+		break;
+	case PMEM_FREE: {
+		uint64_t pa = *(uint64_t *)data;
+		err = ENOENT;
+		for (int i = 0; i < PMEM_LIST_MAX; i++) {
+			if (pm_alloc[i].va && pm_alloc[i].pa == pa) {
+				kmem_free(kernel_map, pm_alloc[i].va, (vm_size_t)pm_alloc[i].size);
+				pm_alloc[i].va = 0;
+				err = 0;
+				break;
+			}
+		}
+		break;
+	}
+	case PMEM_SMC:
+		pm_smc((struct pmem_smc *)data);
+		break;
+	case PMEM_LIST: {
+		struct pmem_list *l = (struct pmem_list *)data;
+		bzero(l, sizeof(*l));
+		for (int i = 0; i < PMEM_LIST_MAX; i++) {
+			if (pm_alloc[i].va) {
+				l->ent[l->count].pa = pm_alloc[i].pa;
+				l->ent[l->count].size = pm_alloc[i].size;
+				l->count++;
+			}
+		}
+		break;
+	}
+	case PMEM_RPMH: {
+		struct pmem_rpmh *r = (struct pmem_rpmh *)data;
+		r->res[sizeof(r->res) - 1] = 0;
+		lck_mtx_unlock(&sweet_pmem_lock);       /* waits up to 100 ms; not under our lock */
+		err = sweet_rpmh_write(r->res, r->n, r->offset, r->value);
+		printf("SWEET PMEM: rpmh %s %u cmds (%#x=%u ...) -> %d\n", r->res, r->n, r->offset[0], r->value[0], err);
+		return err;
+	}
+	default:
+		err = ENOTTY;
+	}
+	lck_mtx_unlock(&sweet_pmem_lock);
+	return err;
+}
+
+static const struct cdevsw sweet_pmem_cdevsw = {
+	.d_open       = pm_open,
+	.d_close      = pm_close,
+	.d_read       = pm_read,
+	.d_write      = pm_write,
+	.d_ioctl      = pm_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+void
+sweet_pmem_init(void)
+{
+	uint32_t on = 1;
+	PE_parse_boot_argn("sweetpmem", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	int major = cdevsw_add(-1, &sweet_pmem_cdevsw);
+	if (major < 0) {
+		printf("SWEET PMEM: cdevsw_add failed (%d)\n", major);
+		return;
+	}
+	devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0600, "pmem");
+	printf("SWEET PMEM: /dev/pmem ready (major %d)\n", major);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_poke.c b/bsd/dev/sweet_poke.c
new file mode 100644
index 0000000..2465222
--- /dev/null
+++ b/bsd/dev/sweet_poke.c
@@ -0,0 +1,242 @@
+/*
+ * Register poke scripts: hardware experiments without a kernel rebuild.
+ * tools/mkpayload.py --poke FILE puts FILE in the ADT as /chosen/sweet-poke;
+ * a kernel thread runs it line by line and logs every step ("POKE:").
+ *
+ *   @SECS                  wait until SECS seconds after the timer started
+ *   r ADDR [N]             read N (default 1) 32-bit words
+ *   w ADDR VAL             write
+ *   m ADDR MASK VAL        read-modify-write: (old & ~MASK) | (VAL & MASK)
+ *   p ADDR MASK VAL MS     poll until (read & MASK) == VAL, at most MS ms
+ *   s MS                   sleep
+ *   # ...                  comment
+ *
+ * Numbers are hex with 0x, else decimal. Addresses are physical; each 4K
+ * page is mapped once (device memory). A read of an unclocked block hangs
+ * the SoC: the RAM log rescue (shim/ramlog.c) keeps the lines up to it.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <mach/mach_time.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+void sweet_poke_start(void);
+void sweet_poke_run(const char *text, unsigned len);
+
+#define POKE_MAPS       32
+#define POKE_TICKS_S    19200000ULL     /* flame timer */
+
+static struct {
+	uint64_t page;
+	vm_offset_t va;
+} poke_map[POKE_MAPS];
+static const char *poke_script;
+static unsigned poke_len;
+
+static volatile uint32_t *
+poke_reg(uint64_t pa)
+{
+	uint64_t page = pa & ~0xfffULL;
+	for (unsigned i = 0; i < POKE_MAPS; i++) {
+		if (poke_map[i].va && poke_map[i].page == page) {
+			return (volatile uint32_t *)(poke_map[i].va + (pa & 0xfff));
+		}
+	}
+	for (unsigned i = 0; i < POKE_MAPS; i++) {
+		if (!poke_map[i].va) {
+			poke_map[i].va = ml_io_map((vm_offset_t)page, 0x1000);
+			poke_map[i].page = page;
+			return poke_map[i].va ? (volatile uint32_t *)(poke_map[i].va + (pa & 0xfff)) : NULL;
+		}
+	}
+	return NULL;
+}
+
+static uint32_t
+poke_rd(volatile uint32_t *r)
+{
+	uint32_t v = *r;
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+poke_wr(volatile uint32_t *r, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*r = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static void
+poke_sleep_ms(unsigned ms)
+{
+	delay((int)ms * 1000);
+}
+
+/* Parse one number; returns false at end of line. */
+static bool
+poke_num(const char **p, const char *end, uint64_t *out)
+{
+	const char *s = *p;
+	while (s < end && (*s == ' ' || *s == '\t')) {
+		s++;
+	}
+	if (s >= end || *s == '\n' || *s == '#') {
+		*p = s;
+		return false;
+	}
+	uint64_t v = 0;
+	unsigned base = 10;
+	if (s + 1 < end && s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) {
+		base = 16;
+		s += 2;
+	}
+	const char *d0 = s;
+	for (; s < end; s++) {
+		unsigned c = (unsigned char)*s, digit;
+		if (c >= '0' && c <= '9') {
+			digit = c - '0';
+		} else if (base == 16 && c >= 'a' && c <= 'f') {
+			digit = c - 'a' + 10;
+		} else if (base == 16 && c >= 'A' && c <= 'F') {
+			digit = c - 'A' + 10;
+		} else if (c == '_') {
+			continue;
+		} else {
+			break;
+		}
+		v = v * base + digit;
+	}
+	*p = s;
+	*out = v;
+	return s > d0;
+}
+
+static void
+poke_line(const char *s, const char *end, unsigned lineno)
+{
+	while (s < end && (*s == ' ' || *s == '\t')) {
+		s++;
+	}
+	if (s >= end || *s == '#' || *s == '\n') {
+		return;
+	}
+	char op = *s++;
+	uint64_t a = 0, b = 0, c = 0, d = 0;
+	bool ha = poke_num(&s, end, &a), hb = poke_num(&s, end, &b);
+	bool hc = poke_num(&s, end, &c), hd = poke_num(&s, end, &d);
+	volatile uint32_t *r = NULL;
+	if (op != '@' && op != 's') {
+		if (!ha || (a & 3) || !(r = poke_reg(a))) {
+			printf("POKE: line %u: bad address\n", lineno);
+			return;
+		}
+	}
+	switch (op) {
+	case '@': {
+		uint64_t target = a * POKE_TICKS_S;
+		while (mach_absolute_time() < target) {
+			poke_sleep_ms(10);
+		}
+		printf("POKE: @%llu s\n", a);
+		break;
+	}
+	case 's':
+		poke_sleep_ms((unsigned)a);
+		break;
+	case 'r': {
+		uint64_t n = hb ? b : 1;
+		for (uint64_t i = 0; i < n && i < 256; i += 4) {
+			char line[96];
+			int len = snprintf(line, sizeof(line), "POKE: r %09llx:", a + 4 * i);
+			for (uint64_t j = i; j < n && j < i + 4; j++) {
+				volatile uint32_t *rj = poke_reg(a + 4 * j);
+				len += snprintf(line + len, sizeof(line) - len, " %08x", rj ? poke_rd(rj) : 0xdeadbeef);
+			}
+			printf("%s\n", line);
+		}
+		break;
+	}
+	case 'w':
+		poke_wr(r, (uint32_t)b);
+		printf("POKE: w %09llx = %08llx -> %08x\n", a, b, poke_rd(r));
+		break;
+	case 'm': {
+		uint32_t old = poke_rd(r);
+		poke_wr(r, (old & ~(uint32_t)b) | ((uint32_t)c & (uint32_t)b));
+		printf("POKE: m %09llx %08x -> %08x\n", a, old, poke_rd(r));
+		break;
+	}
+	case 'p': {
+		uint64_t ms = hd ? d : 100, t;
+		uint32_t v = 0;
+		for (t = 0; t <= ms; t++) {
+			v = poke_rd(r);
+			if ((v & (uint32_t)b) == (uint32_t)c) {
+				break;
+			}
+			poke_sleep_ms(1);
+		}
+		printf("POKE: p %09llx & %08llx == %08llx: %s after %llu ms (%08x)\n", a, b, c,
+		    t <= ms ? "ok" : "TIMEOUT", t, v);
+		break;
+	}
+	default:
+		printf("POKE: line %u: unknown op '%c'\n", lineno, op);
+	}
+	(void)hc;
+}
+
+/* Run script text in the calling thread (also used by the USB command server). */
+void
+sweet_poke_run(const char *text, unsigned len)
+{
+	const char *s = text, *end = text + len;
+	unsigned lineno = 1;
+	while (s < end && *s) {
+		const char *e = s;
+		while (e < end && *e && *e != '\n') {
+			e++;
+		}
+		poke_line(s, e, lineno++);
+		s = e < end && *e == '\n' ? e + 1 : e;
+	}
+}
+
+static void
+poke_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	printf("POKE: running %u-byte script\n", poke_len);
+	sweet_poke_run(poke_script, poke_len);
+	printf("POKE: done\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_poke_start(void)
+{
+	DTEntry chosen;
+	void const *script;
+	unsigned size;
+	if (SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "sweet-poke", &script, &size) != kSuccess || size < 2) {
+		return;
+	}
+	poke_script = (const char *)script;
+	poke_len = size;
+	thread_t thread;
+	if (kernel_thread_start(poke_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */

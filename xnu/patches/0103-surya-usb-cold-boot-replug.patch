+/*
+ * surya: after a normal power-on (no fastboot) ABL leaves USB off: the USB30_PRIM GDSC collapsed, the clocks
+ * gated and the QUSB2 PHY unpowered, so the device never appeared. Bring it up as Linux does (gdsc, clk
+ * rcg2/branch, dwc3-msm, phy-msm-qusb-v2.c), only when the GDSC is off: after fastboot ABL's setup is used as
+ * before. Every step is logged (the persistent log keeps it when USB does not come up).
+ */
+static bool ud_cold;
+extern int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
+
+static void
+usb_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* surya DT qusb@88e2000 qcom,qusb-phy-init-seq: value, offset pairs (PWR_CTRL1 0x210 down first, up last) */
+static const uint32_t qusb2_init_seq[] = {
+	0x23, 0x210, 0x03, 0x04, 0x7c, 0x18c, 0x80, 0x2c, 0x0a, 0x184, 0x19, 0xb4, 0x40, 0x194,
+	0x22, 0x198, 0x21, 0x214, 0x08, 0x220, 0x58, 0x224, 0x77, 0x240, 0x7c, 0x244, 0xca, 0x248,
+	0x04, 0x24c, 0x03, 0x250, 0x30, 0x23c, 0x22, 0x210,
+};
+
+static int
+usb_cold_power(vm_offset_t gcc)
+{
+	uint32_t g = usb_rd(gcc, GCC_USB30_PRIM_GDSCR);
+	if (g & (1u << 31)) {
+		return 0;			/* ABL (fastboot) left it on */
+	}
+	ud_cold = true;
+	printf("SWEET USB: cold boot: GDSC 0x%08x off, powering USB up\n", g);
+	int r4 = sweet_rpmh_vreg_enable("ldoa4", 880);
+	int r11 = sweet_rpmh_vreg_enable("ldoa11", 1800);
+	int r17 = sweet_rpmh_vreg_enable("ldoa17", 3072);
+	printf("SWEET USB: cold: PHY supplies ldoa4 %d ldoa11 %d ldoa17 %d\n", r4, r11, r17);
+	usb_wr(gcc, GCC_USB30_PRIM_GDSCR, g & ~1u);	/* SW_COLLAPSE off */
+	int i;
+	for (i = 0; i < 100 && !(usb_rd(gcc, GCC_USB30_PRIM_GDSCR) & (1u << 31)); i++) {
+		delay(100);
+	}
+	printf("SWEET USB: cold: GDSC 0x%08x after %d00 us\n", usb_rd(gcc, GCC_USB30_PRIM_GDSCR), i);
+	/* master 200 MHz: GPLL0_OUT_MAIN (src 1) / 3 (2*3-1); mock_utmi 19.2 MHz: XO (src 0) / 1 */
+	usb_wr(gcc, 0xf01c + 4, (1u << 8) | 5u);
+	usb_wr(gcc, 0xf01c, usb_rd(gcc, 0xf01c) | 1u);		/* CMD_UPDATE */
+	usb_wr(gcc, 0xf034 + 4, (0u << 8) | 1u);
+	usb_wr(gcc, 0xf034, usb_rd(gcc, 0xf034) | 1u);
+	for (i = 0; i < 100 && ((usb_rd(gcc, 0xf01c) | usb_rd(gcc, 0xf034)) & 1u); i++) {
+		delay(10);
+	}
+	static const uint32_t branches[] = { 0x0f010, 0x0f014, 0x0f018, 0x0502c, 0x8201c, 0x6a004, 0x8c010 };
+	for (unsigned b = 0; b < sizeof(branches) / sizeof(branches[0]); b++) {
+		usb_wr(gcc, branches[b], usb_rd(gcc, branches[b]) | 1u);
+	}
+	for (i = 0; i < 100 && ((usb_rd(gcc, 0x0f010) | usb_rd(gcc, 0x0502c)) & CBCR_CLK_OFF); i++) {
+		delay(10);
+	}
+	printf("SWEET USB: cold: rcg master 0x%08x/0x%08x utmi 0x%08x, CBCR master 0x%08x cfg-noc 0x%08x\n",
+	    usb_rd(gcc, 0xf01c), usb_rd(gcc, 0xf020), usb_rd(gcc, 0xf038), usb_rd(gcc, 0x0f010), usb_rd(gcc, 0x0502c));
+	/* block resets: QUSB2 PHY, then the controller */
+	usb_wr(gcc, 0x26000, 1u);
+	delay(100);
+	usb_wr(gcc, 0x26000, 0u);
+	usb_wr(gcc, 0x0f000, 1u);
+	delay(100);
+	usb_wr(gcc, 0x0f000, 0u);
+	delay(100);
+	vm_offset_t phy = ml_io_map(QUSB2_PA, QUSB2_SIZE);
+	if (phy == 0) {
+		printf("SWEET USB: cold: QUSB2 map failed\n");
+		return -1;
+	}
+	for (unsigned k = 0; k + 1 < sizeof(qusb2_init_seq) / sizeof(qusb2_init_seq[0]); k += 2) {
+		usb_wr(phy, qusb2_init_seq[k + 1], qusb2_init_seq[k]);
+		if (k == 0) {
+			delay(10);
+		}
+	}
+	for (i = 0; i < 100 && !(usb_rd(phy, 0x1a0) & 1u); i++) {
+		delay(100);
+	}
+	printf("SWEET USB: cold: QUSB2 PLL status 0x%08x after %d00 us, PWR_CTRL1 0x%08x\n",
+	    usb_rd(phy, 0x1a0), i, usb_rd(phy, 0x210));
+	return 1;
+}

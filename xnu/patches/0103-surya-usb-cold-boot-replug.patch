+/*
+ * A cable replug (or a host reset) arrives as disconnect / bus reset. As Linux dwc3
+ * (dwc3_stop_active_transfers, ep0 back to SETUP): end the data endpoints' transfers, drop the
+ * configuration (SET_CONFIGURATION builds it again), rearm control. Before this only the address
+ * was cleared and the old transfers stayed, so after a replug the host enumerated the phone but no
+ * frame went through.
+ */
+static void
+ud_end_transfer(unsigned ep)
+{
+	uint32_t rsc = (dwc_rd(DEPCMD(ep)) >> 16) & 0x7f;
+	(void)ud_epcmd(ep, 8u | (1u << 11) | (rsc << 16), 0, 0, 0);	/* ENDTRANSFER, ForceRM */
+}
+
+static void
+ud_bus_reset(const char *why)
+{
+	uint32_t ena = dwc_rd(DALEPENA);
+	static const unsigned eps[] = { EP_RX, EP_TX, EP_INT };
+	for (unsigned i = 0; i < 3; i++) {
+		if (ena & (1u << eps[i])) {
+			ud_end_transfer(eps[i]);
+		}
+	}
+	dwc_wr(DALEPENA, ena & 0x3u);
+	bool was = ud.configured;
+	lck_mtx_lock(ud.lock);
+	ud.configured = false;
+	ud.tx_busy = false;
+	lck_mtx_unlock(ud.lock);
+	ud.data_alt = 0;
+	if (was) {
+		ud_link_event(false);
+	}
+	if (ud.state != EP0_SETUP) {
+		ud_end_transfer(0);
+		ud_end_transfer(1);
+		ud_start_setup();
+	}
+	printf("SWEET USB: %s: transfers ended, configuration dropped%s\n", why, was ? " (link down)" : "");
+}

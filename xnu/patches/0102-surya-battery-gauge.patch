+/*
+ * surya: a small fuel gauge. The PM6150 QG only measures; Linux computes the state of charge itself from a
+ * battery profile. A voltage-only estimate jumped (11% -> 66% in 30 s on a fast charger: the charging current
+ * lifts the terminal voltage). Here: the starting point from the voltage corrected for I*R (resting voltage),
+ * then coulomb counting with the measured current over the 5160 mAh cell (surya), pulled gently toward the
+ * corrected voltage while the current is small; shown as rising only while charging and falling only on
+ * battery. Full (charger done) is 100%.
+ */
+#define SWEET_BATT_MAH          5160
+#define SWEET_BATT_MOHM         120	/* cell + path resistance for the I*R correction */
+
+unsigned
+SweetBattery::gaugePercent(unsigned mv, int ma, bool currentValid, bool external, bool full)
+{
+	/* ma > 0: into the battery (charging) */
+	int ocv = (int)mv - (currentValid ? ma * SWEET_BATT_MOHM / 1000 : 0);
+	int32_t target = (int32_t)estimatePercent(ocv > 0 ? (unsigned)ocv : 0) * 1000;
+	uint64_t now = mach_absolute_time();
+	if (full) {
+		fSocMilli = 100000;
+		fSocAbs = now;
+		return 100;
+	}
+	if (fSocMilli < 0 || fSocAbs == 0) {
+		fSocMilli = target;
+		fSocAbs = now;
+		return (unsigned)((fSocMilli + 500) / 1000);
+	}
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(now - fSocAbs, &ns);
+	fSocAbs = now;
+	int32_t before = fSocMilli;
+	int32_t next = fSocMilli;
+	if (currentValid) {
+		/* coulomb count: mA * s / (mAh * 3600) * 100% */
+		int64_t delta = (int64_t)ma * (int64_t)(ns / 1000000ULL) * 100000LL / ((int64_t)SWEET_BATT_MAH * 3600000LL);
+		next += (int32_t)delta;
+	}
+	if (!currentValid || (ma > -300 && ma < 300)) {
+		next += (target - next) / 8;	/* near rest: drift toward the corrected voltage */
+	}
+	/* on the charger the shown level only rises; on battery it only falls */
+	if (external && next < before) {
+		next = before;
+	} else if (!external && next > before) {
+		next = before;
+	}
+	if (next < 0) {
+		next = 0;
+	} else if (next > 99000 && !full) {
+		next = 99000;			/* 100% only when the charger says done */
+	}
+	fSocMilli = next;
+	return (unsigned)((fSocMilli + 500) / 1000);
+}

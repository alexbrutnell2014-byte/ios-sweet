 	IOLockUnlock(sp_lock);
 	return -1;
 }
+
+/*
+ * Power-off and reboot (SweetPlatformExpert's halt/restart handler): the PM6150 PON block (SID 0, 0x0800),
+ * whose PS_HOLD reset type decides what dropping PS_HOLD does. Its channel is found and mapped at boot
+ * (sweet_spmi_pon_prepare, thread context); sweet_spmi_pon_write runs at halt time with interrupts off, so it
+ * takes no lock and maps nothing.
+ */
+static vm_offset_t sp_pon_ch;
+
+int
+sweet_spmi_pon_prepare(void)
+{
+	if (!sp_ready) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid(0x008);
+	unsigned owner = apid == SP_NO_APID ? 7u : (sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u);
+	if (apid != SP_NO_APID && owner == 0 && !sp_poisoned[apid]) {
+		sp_pon_ch = ml_io_map(SP_CHNLS_PA + 0x10000u * apid, 0x1000);
+	}
+	IOLockUnlock(sp_lock);
+	printf("SWEET POWER: PON APID %u owner %u -> %s\n", apid, owner, sp_pon_ch ? "ready" : "NOT WRITABLE");
+	return sp_pon_ch ? 0 : -1;
+}
+
+int
+sweet_spmi_pon_write(unsigned addr, uint8_t val)
+{
+	vm_offset_t ch = sp_pon_ch;
+	if (!ch || (addr >> 8) != 0x08) {
+		return -1;
+	}
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x10u) = val;			/* WDATA0 */
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x00u) = (addr & 0xffu) << 4;	/* EXT_WRITEL (0), BC=0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(ch, 0x08u);
+		if (status & 1u) {
+			return (status & 0x0eu) ? -1 : 0;
+		}
+		delay(1);
+	}
+	return -1;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */

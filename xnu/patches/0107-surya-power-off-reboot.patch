 /* surya: no sweet_log_mirror_start(): flame's 0x1fe000000 mirror is past the end of RAM. */
 
+/*
+ * Power-off and reboot. Without a PE_halt_restart handler XNU's halt_all_cpus() printed "CPU halted" and spun
+ * forever with every core on: "Slide to power off" left a dark phone that emptied its battery in about an hour,
+ * and a reboot from iOS never rebooted. As downstream msm-poweroff + qpnp-power-on (gen2 PON) do: PS_HOLD reset
+ * type in the PM6150 PON (PS_HOLD_RESET_CTL 0x85a: 0x04 shutdown, 0x07 hard reset; CTL2 0x85b bit 7 enables it,
+ * cleared around the change with a few sleep-clock cycles between), then PSCI SYSTEM_OFF / SYSTEM_RESET, which
+ * TrustZone carries out by dropping PS_HOLD. Panics keep their screen (only the halt and restart types are taken).
+ */
+#define PON_PS_HOLD_RESET_CTL   0x085a
+#define PON_PS_HOLD_RESET_CTL2  0x085b
+#define PSCI_SYSTEM_OFF         0x84000008ULL
+#define PSCI_SYSTEM_RESET       0x84000009ULL
+
+static bool sweet_pon_ready;
+
+static void
+sweet_psci_call(uint64_t fn)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = 0;
+	register uint64_t x2 __asm__("x2") = 0;
+	register uint64_t x3 __asm__("x3") = 0;
+	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "cc", "memory");
+}
+
+static int
+sweet_halt_restart(unsigned int type)
+{
+	uint8_t reset_type;
+	uint64_t fn;
+	if (type == kPEHaltCPU) {
+		reset_type = 0x04;
+		fn = PSCI_SYSTEM_OFF;
+	} else if (type == kPERestartCPU) {
+		reset_type = 0x07;
+		fn = PSCI_SYSTEM_RESET;
+	} else {
+		return -1;
+	}
+	kprintf("SWEET POWER: %s\n", type == kPEHaltCPU ? "power off" : "restart");
+	if (sweet_pon_ready) {
+		int rc = sweet_spmi_pon_write(PON_PS_HOLD_RESET_CTL2, 0x00);
+		delay(100);
+		rc |= sweet_spmi_pon_write(PON_PS_HOLD_RESET_CTL, reset_type);
+		rc |= sweet_spmi_pon_write(PON_PS_HOLD_RESET_CTL2, 0x80);
+		kprintf("SWEET POWER: PS_HOLD reset type %#x -> %d\n", reset_type, rc);
+	}
+	sweet_psci_call(fn);
+	kprintf("SWEET POWER: PSCI %#llx returned\n", fn);
+	return -1;
+}

+/*
+ * surya: one plain LDR/STR per word, no writeback, no pairs. On SM7150 the hypervisor emulates EL1
+ * accesses to the apps SMMU; it can only do so when the abort syndrome is valid (ISV=1), which
+ * post-indexed, paired or vector accesses (what the compiler made of the copy loops) do not give:
+ * those reads never returned. sweet_poke.c and sweet_usb.c always did single plain loads.
+ */
+static inline uint32_t
+pm_ldr32(volatile uint32_t *p)
+{
+	uint32_t v;
+	__asm__ volatile ("ldr %w0, [%1]" : "=r"(v) : "r"(p) : "memory");
+	return v;
+}
+
+static inline void
+pm_str32(volatile uint32_t *p, uint32_t v)
+{
+	__asm__ volatile ("str %w0, [%1]" : : "r"(v), "r"(p) : "memory");
+}
+
 static int
 pm_rw(struct uio *uio, bool write)
 {

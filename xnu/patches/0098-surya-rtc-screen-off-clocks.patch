 		}
+		osm_base[c] = base;
+		osm_on[c] = best;
+		osm_off[c] = 0;
+		{
+			/* screen off: pwrcl at most 1017 MHz (background work still runs), perfcl at its lowest */
+			unsigned cap_khz = c == 0 ? 1017000u : 0u, prev = 0;
+			for (unsigned i = 0; i < n; ++i) {

 }
+/*
+ * Display on/off (SweetFramebuffer.cpp, RequestPowerChange): full speed while the screen is on, low while it is
+ * off. Nothing else scales the clocks, so without this a locked phone ran every core at its top all night.
+ * Boot-arg sweetcpufreq=0 (clusters left as ABL set them) also leaves this alone.
+ */
+void
+sweet_cpufreq_screen(int on)
+{
+	if (!osm_ready) {
+		return;
+	}
+	for (unsigned c = 0; c < sizeof(osm_clusters) / sizeof(osm_clusters[0]); ++c) {
+		if (!osm_base[c]) {
+			continue;
+		}
+		__asm__ volatile("dmb oshst" ::: "memory");
+		*(volatile uint32_t *)(osm_base[c] + OSM_DESIRED) = on ? osm_on[c] : osm_off[c];
+		__asm__ volatile("dsb osh" ::: "memory");
+	}
+	printf("SWEET CPUFREQ: screen %s: pwrcl index %u, perfcl index %u\n", on ? "on" : "off",
+	    on ? osm_on[0] : osm_off[0], on ? osm_on[1] : osm_off[1]);
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */

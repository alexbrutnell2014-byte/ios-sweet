 extern "C" void sweet_poke_start(void);
+
+/*
+ * Time of day (from ios-flame 0099, MIT): the PM6150 RTC (SPMI SID 0, peripheral 0x6000) counts seconds from
+ * whenever it was last set; HLOS cannot write it (surya DT qcom,qpnp-rtc-write = 0), Android keeps an offset.
+ * Here the offset is boot-arg sweetrtcoff (seconds; computed on the PC when the image is made). Without a time
+ * of day every boot started in 1970: daemons' history got 1969 dates (coreduetd/dasd then queried 57 years in a
+ * loop) and every boot had the same boottime. Published as the IORTC resource, which IOKitInitializeTime
+ * waits up to 30 s for.
+ */
+#include "../../../bsd/dev/sweet_spmi.h"
+
+#define PM6150_RTC_CTRL         0x6046
+#define PM6150_RTC_RDATA0       0x6048
+
+static int
+sweet_rtc_read(uint32_t *secs)
+{
+	uint8_t b[4], again;
+	if (sweet_spmi_init() != 0) {
+		return -1;
+	}
+	for (int tries = 0; tries < 3; tries++) {
+		for (unsigned i = 0; i < 4; i++) {
+			if (sweet_spmi_read(0, PM6150_RTC_RDATA0 + i, &b[i]) != 0) {
+				return -1;
+			}
+		}
+		/* the low byte rolled over between the reads: read again (rtc-pm8xxx does the same) */
+		if (sweet_spmi_read(0, PM6150_RTC_RDATA0, &again) != 0) {
+			return -1;
+		}
+		if (again >= b[0]) {
+			*secs = (uint32_t)b[0] | ((uint32_t)b[1] << 8) | ((uint32_t)b[2] << 16) | ((uint32_t)b[3] << 24);
+			return 0;
+		}
+	}
+	return -1;
+}
+
+long
+SweetPlatformExpert::getGMTTimeOfDay(void)
+{
+	uint32_t rtc = 0;
+	uint64_t off = 0;
+	if (sweet_rtc_read(&rtc) != 0) {
+		return 0;
+	}
+	(void)PE_parse_boot_argn("sweetrtcoff", &off, sizeof(off));
+	return (long)((uint64_t)rtc + off);
+}
+
+void
+SweetPlatformExpert::setGMTTimeOfDay(long secs)
+{
+	uint32_t rtc = 0;
+	if (sweet_rtc_read(&rtc) == 0) {
+		/* the offset to use as sweetrtcoff from now on */
+		IOLog("SWEET RTC: time set to %ld (RTC %u): sweetrtcoff=%ld\n", secs, rtc, secs - (long)rtc);
+	}
+}

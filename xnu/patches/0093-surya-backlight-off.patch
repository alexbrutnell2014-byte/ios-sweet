index a62416c..fb9f295 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -37,6 +37,37 @@
 #include "SweetSurface.h"
 
 extern "C" int sweet_console_muted;     /* osfmk/console/serial_console.c */
+extern "C" int sweet_spmi_init(void);   /* bsd/dev/sweet_spmi.c */
+extern "C" int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+extern "C" int sweet_spmi_write(unsigned sid, unsigned addr, uint8_t val);
+
+/*
+ * surya is an LCD: black pixels still glow, so display off must also stop the backlight.
+ * PM6150L WLED MOD_EN (SID 5, 0xd846) bit 7 is the module enable (mainline qcom-wled
+ * wled_module_enable); the value found at the first off is restored on.
+ */
+static void
+sweet_backlight(bool on)
+{
+	static int saved = -1;
+	uint8_t v = 0;
+	if (sweet_spmi_init() || sweet_spmi_read(5, 0xd846, &v)) {
+		IOLog("SWEET FB: backlight: WLED not reachable\n");
+		return;
+	}
+	if (!on) {
+		if (v & 0x80) {
+			saved = v;
+		}
+		v &= 0x7f;
+	} else {
+		v = saved >= 0 ? (uint8_t)saved : (uint8_t)(v | 0x80);
+	}
+	int rc = sweet_spmi_write(5, 0xd846, v);
+	uint8_t back = 0xff;
+	(void)sweet_spmi_read(5, 0xd846, &back);
+	IOLog("SWEET FB: backlight %s: mod_en %#x -> rc %d, reads %#x\n", on ? "on" : "off", v, rc, back);
+}
 
